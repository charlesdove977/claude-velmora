# Velmora Aesthetics. Copy to .env and fill in. Nothing here is required for a local demo:
# without RESEND_API_KEY every form logs its payload to the server console and still returns success.

# Resend API key (https://resend.com). Enables real email delivery for booking, contact, support, gift card, newsletter.
RESEND_API_KEY=

# Where spa-side notifications go (booking requests, contact, support, gift card requests).
SPA_INBOX_EMAIL=hello@velmora-aesthetics.com

# Verified sender in Resend. Must be on a domain you have verified in Resend.
EMAIL_FROM="Velmora Aesthetics <hello@velmora-aesthetics.com>"

# Optional: Resend Audience ID for newsletter sign-ups. Without it, sign-ups are emailed to SPA_INBOX_EMAIL.
RESEND_AUDIENCE_ID=

# Public site URL used for canonical links, sitemap and .ics files.
PUBLIC_SITE_URL=https://velmora-aesthetics.com
