---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Quiz from "@/components/islands/Quiz";
import { treatments } from "@/data/treatments";
import { breadcrumbLd } from "@/lib/seo";

const catalog = treatments.map((t) => ({ slug: t.slug, name: t.name, benefit: t.benefit, priceFrom: t.priceFrom, priceUnit: t.priceUnit, image: t.image, spec: { downtime: t.spec.downtime, duration: t.spec.duration } }));
const crumbs = [{ name: "Home", href: "/" }, { name: "Treatment Match", href: "/quiz" }];
---
<BaseLayout title="Treatment Match: 60-Second Quiz" description="Six quick questions about your concern, downtime and timeline, and three treatments worth a conversation. Then book directly." jsonLd={[breadcrumbLd(crumbs)]} stickyBook={false}>
  <section class="min-h-[100svh] bg-bone pt-[calc(var(--nav-h)_+_2.5rem)] pb-section">
    <div class="mx-auto max-w-content px-4 md:px-8 xl:px-12">
      <div class="mx-auto max-w-3xl">
        <p class="eyebrow">Treatment Match</p>
        <h1 class="mt-3 text-fluid-3xl text-ink">Sixty seconds to a starting point</h1>
        <p class="mt-4 text-fluid-md text-ink-soft">Not medical advice, and not a diagnosis. A short way to narrow thirteen treatments to three worth discussing.</p>
      </div>
      <div class="mt-12">
        <Quiz client:load catalog={catalog} />
      </div>
    </div>
  </section>
</BaseLayout>
