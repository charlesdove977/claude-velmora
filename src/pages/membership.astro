---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import Button from "@/components/ui/Button.astro";
import Accordion from "@/components/ui/Accordion.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import { memberships, membershipFaqs } from "@/data/memberships";
import { breadcrumbLd, faqLd } from "@/lib/seo";

const crumbs = [{ name: "Home", href: "/" }, { name: "Membership", href: "/membership" }];
const rows = [
  { label: "Monthly facial or light peel", values: ["Included", "Included", "Included"] },
  { label: "Banked treatment credit", values: ["None", "$200 / month", "$450 / month"] },
  { label: "Discount on injectables and laser", values: ["10%", "15%", "20%"] },
  { label: "Discount on skincare", values: ["15%", "15%", "20%"] },
  { label: "Complimentary IPL or peel", values: ["No", "1 per year", "1 per year"] },
  { label: "Guest facial passes", values: ["No", "2 per year", "4 per year"] },
  { label: "Quarterly IV drip and body scan", values: ["No", "No", "Included"] },
  { label: "Annual planning visit with Dr. Marsh", values: ["No", "No", "Included"] },
  { label: "Same-week concierge scheduling", values: ["Priority booking", "Priority booking", "Included"] },
];
---
<BaseLayout title="Membership: Glow, Refine and Reserve" description="Three membership tiers that bank treatment credit monthly, include a facial, and take 10 to 20 percent off everything else. Month to month after 3 months." jsonLd={[breadcrumbLd(crumbs), faqLd(membershipFaqs)]}>
  <PageHero eyebrow="Membership" title="Maintenance, already paid for" lede="A membership turns aesthetic care into a monthly habit instead of an occasional splurge. Credit banks every month, facials are included, and everything else is discounted." crumbs={crumbs} />

  <section class="pb-section-sm">
    <div class="mx-auto max-w-content px-4 md:px-8 xl:px-12">
      <div class="grid gap-5 lg:grid-cols-3">
        {memberships.map((m, i) => (
          <article class:list={["reveal relative flex flex-col rounded-lg border p-8", m.highlight ? "border-champagne bg-espresso text-bone shadow-lift" : "border-stone/40 bg-bone"]} data-delay={i * 100}>
            {m.highlight && <span class="absolute right-6 top-6 rounded-pill bg-champagne px-3 py-1 text-[0.6875rem] font-semibold uppercase tracking-eyebrow text-espresso">Most chosen</span>}
            <p class:list={["eyebrow", m.highlight && "text-champagne"]}>{m.name}</p>
            <p class="mt-3 font-display text-fluid-3xl leading-none">${m.monthly}<span class:list={["text-fluid-sm", m.highlight ? "text-stone" : "text-ink-muted"]}> / month</span></p>
            <p class:list={["mt-1 text-fluid-xs", m.highlight ? "text-stone" : "text-ink-muted"]}>or ${m.annual.toLocaleString()} a year, prepaid</p>
            <p class:list={["mt-5 font-display text-fluid-md", m.highlight ? "text-bone" : "text-ink"]}>{m.tagline}</p>
            <p class:list={["mt-2 text-fluid-sm", m.highlight ? "text-stone" : "text-ink-soft"]}>Best for: {m.bestFor}</p>
            <ul class:list={["mt-6 flex-1 space-y-3 text-fluid-sm", m.highlight ? "text-bone/90" : "text-ink"]}>
              {m.includes.map((x) => <li class="flex gap-3"><span class="mt-[0.65em] h-px w-3 shrink-0 bg-champagne"></span>{x}</li>)}
            </ul>
            <div class:list={["mt-7 rounded-md p-4 text-fluid-xs", m.highlight ? "bg-bone/10 text-stone" : "bg-bone-deep text-ink-soft"]}>
              <p class:list={["font-semibold", m.highlight ? "text-champagne" : "text-gold-text"]}>{m.savings}</p>
              <p class="mt-1">{m.savingsMath}</p>
            </div>
            <div class="mt-7">
              <Button href={`/contact?topic=membership&tier=${m.slug}`} variant={m.highlight ? "gold" : "primary"} full>Join {m.name}</Button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-stone/40 py-section-sm">
    <div class="mx-auto max-w-content px-4 md:px-8 xl:px-12">
      <h2 class="reveal font-display text-fluid-2xl text-ink">Side by side</h2>
      <div class="reveal mt-8 overflow-x-auto" data-delay="100">
        <table class="w-full min-w-[640px] border-collapse text-fluid-sm">
          <thead>
            <tr class="border-b border-stone/60 text-left">
              <th class="py-3 pr-4 font-semibold text-ink-muted">Includes</th>
              {memberships.map((m) => <th class="py-3 pr-4 font-display text-fluid-md font-normal text-ink">{m.name}</th>)}
            </tr>
          </thead>
          <tbody class="divide-y divide-stone/40">
            {rows.map((r) => (
              <tr>
                <th scope="row" class="py-3 pr-4 text-left font-normal text-ink-soft">{r.label}</th>
                {r.values.map((v) => <td class="py-3 pr-4 text-ink">{v}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-bone-deep py-section-sm">
    <div class="mx-auto grid max-w-content gap-10 px-4 md:px-8 lg:grid-cols-12 xl:px-12">
      <div class="lg:col-span-4">
        <p class="eyebrow reveal">Membership questions</p>
        <h2 class="reveal mt-3 text-fluid-2xl text-ink" data-delay="60">The fine print, in plain words</h2>
      </div>
      <div class="reveal lg:col-span-7 lg:col-start-6" data-delay="100"><Accordion items={membershipFaqs} name="membership-faq" /></div>
    </div>
  </section>
  <CtaBand title="Not sure which tier?" body="Book a consultation and a coordinator will run the math on your actual plan. Most people land on Refine." />
</BaseLayout>
