---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import Picture from "@/components/ui/Picture.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import { getCollection } from "astro:content";
import { breadcrumbLd } from "@/lib/seo";
const posts = (await getCollection("journal")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const crumbs = [{ name: "Home", href: "/" }, { name: "Journal", href: "/journal" }];
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---
<BaseLayout title="Journal: Notes from the Clinic" description="Plain-spoken articles from Velmora's providers on treatments, Scottsdale skin, and the philosophy behind natural results." jsonLd={[breadcrumbLd(crumbs)]}>
  <PageHero eyebrow="Journal" title="Notes from the clinic" lede="Written by the people who do the treatments. No sponsored content, no miracle claims, no exclamation points." crumbs={crumbs} compact />
  <section class="pb-section">
    <div class="mx-auto max-w-content px-4 md:px-8 xl:px-12">
      <div class="grid gap-10 md:grid-cols-3">
        {posts.map((p, i) => (
          <a href={`/journal/${p.id}`} class="reveal group" data-delay={i * 90}>
            <Picture name={p.data.image} alt={p.data.imageAlt} ratio="3/2" class="rounded-md" imgClass="transition-transform duration-[1200ms] ease-out-expo group-hover:scale-[1.03]" sizes="(min-width: 768px) 33vw, 100vw" width={900} height={600} />
            <p class="eyebrow mt-5">{p.data.category} · {p.data.readingMinutes} min read</p>
            <h2 class="mt-2 font-display text-fluid-lg leading-snug text-ink group-hover:text-gold-text">{p.data.title}</h2>
            <p class="mt-2 text-fluid-sm text-ink-soft">{p.data.description}</p>
            <p class="mt-3 text-fluid-xs text-ink-muted">{p.data.author} · {fmt(p.data.date)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
