---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import TreatmentCard from "@/components/ui/TreatmentCard.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import { concerns, getConcern } from "@/data/concerns";
import { treatmentsForConcern } from "@/data/treatments";
import { breadcrumbLd } from "@/lib/seo";

export function getStaticPaths() {
  return concerns.map((c) => ({ params: { slug: c.slug } }));
}
const c = getConcern(Astro.params.slug!)!;
const list = treatmentsForConcern(c.slug);
const crumbs = [{ name: "Home", href: "/" }, { name: "Concerns", href: "/concerns/lines-wrinkles" }, { name: c.name, href: `/concerns/${c.slug}` }];
---
<BaseLayout title={`${c.name}: treatments in Scottsdale`} description={c.intro} image={`/images/${c.image}-1200.webp`} jsonLd={[breadcrumbLd(crumbs)]}>
  <PageHero eyebrow="Concern" title={c.name} lede={c.intro} image={c.image} imageAlt={c.imageAlt} crumbs={crumbs} />

  <section class="border-t border-stone/40 py-section-sm">
    <div class="mx-auto grid max-w-content gap-12 px-4 md:px-8 lg:grid-cols-12 xl:px-12">
      <div class="prose-velmora reveal text-fluid-md text-ink-soft lg:col-span-7">
        {c.body.map((p) => <p>{p}</p>)}
      </div>
      <aside class="reveal rounded-md border border-stone/40 bg-bone-deep p-7 lg:col-span-4 lg:col-start-9" data-delay="120">
        <p class="eyebrow">Our approach</p>
        <ol class="mt-4 space-y-4">
          {c.approach.map((a, i) => (
            <li class="flex gap-4 text-fluid-sm text-ink"><span class="font-display text-fluid-md text-champagne">0{i + 1}</span><span>{a}</span></li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  <section class="pb-section">
    <div class="mx-auto max-w-content px-4 md:px-8 xl:px-12">
      <p class="eyebrow reveal">Treatments for {c.name.toLowerCase()}</p>
      <h2 class="reveal mt-3 text-fluid-2xl text-ink" data-delay="60">Matched to the cause</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {list.map((t, i) => <TreatmentCard t={t} index={i} />)}
      </div>
      <nav class="mt-14 border-t border-stone/40 pt-6" aria-label="Other concerns">
        <p class="text-fluid-xs uppercase tracking-eyebrow text-ink-muted">Other concerns</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {concerns.filter((x) => x.slug !== c.slug).map((x) => (
            <li><a href={`/concerns/${x.slug}`} class="inline-block rounded-pill border border-stone/60 px-4 py-2 text-fluid-sm text-ink-soft transition-colors hover:border-espresso hover:text-ink">{x.name}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
