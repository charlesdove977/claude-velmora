---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import { site } from "@/config/site";
import { aftercare } from "@/data/aftercare";

const prep = [
  "Arrive 10 minutes early for a first visit to complete intake. Bring photo ID and a list of medications.",
  "Skip alcohol, aspirin, ibuprofen and fish oil for 24 hours before injectables if your physician allows.",
  "No sun exposure or self-tanner for 2 weeks before any laser or light treatment.",
  "Come with a clean face. If you cannot, we will cleanse for you.",
  "Tell us about pregnancy, breastfeeding, cold sores, recent antibiotics or isotretinoin.",
];
---
<BaseLayout title="Booking request received" description="Your booking request is in. What happens next, how to prepare, and how to change your appointment." noindex stickyBook={false}>
  <section class="bg-bone pt-[calc(var(--nav-h)_+_2.5rem)] pb-section">
    <div class="mx-auto max-w-content px-4 md:px-8 xl:px-12">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow">Request received</p>
          <h1 class="mt-3 text-fluid-3xl text-ink">Thank you. We have it.</h1>
          <p class="mt-4 text-fluid-md text-ink-soft">A coordinator will confirm within one business hour during opening hours. A confirmation email with a calendar file is on its way.</p>
          <div id="booking-summary" class="mt-8 rounded-md border border-champagne/50 bg-bone-deep p-6">
            <p class="text-fluid-xs uppercase tracking-eyebrow text-gold-text">Reference</p>
            <p class="mt-1 font-display text-fluid-2xl text-ink" data-ref>Loading…</p>
            <dl class="mt-4 grid gap-3 text-fluid-sm sm:grid-cols-3">
              <div><dt class="text-ink-muted">Treatment</dt><dd class="text-ink" data-treatments></dd></div>
              <div><dt class="text-ink-muted">Provider</dt><dd class="text-ink" data-provider></dd></div>
              <div><dt class="text-ink-muted">When</dt><dd class="text-ink" data-when></dd></div>
            </dl>
            <div class="mt-6 flex flex-wrap gap-3">
              <a id="ics-link" href="#" download="velmora-appointment.ics" class="inline-flex h-11 items-center gap-2 rounded-pill bg-espresso px-5 text-fluid-sm font-semibold text-bone hover:bg-espresso-soft">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 2v9M4 7l4 4 4-4M2 13h12" /></svg>
                Add to calendar (.ics)
              </a>
              <Button href="/" variant="ghost">Back to home</Button>
            </div>
            <p class="mt-4 hidden text-fluid-xs text-ink-muted" data-nomail>Email delivery is not configured on this demo, so the request was logged on the server instead. The reference above is real.</p>
          </div>
          <p class="mt-6 text-fluid-sm text-ink-soft">Need to change anything? Reply to the confirmation email or call <a href={site.phoneHref} class="underline decoration-champagne underline-offset-4">{site.phone}</a>. We ask for 24 hours' notice.</p>
        </div>
        <aside class="lg:col-span-5">
          <div class="rounded-md border border-stone/40 p-7">
            <p class="eyebrow">Before your visit</p>
            <ul class="mt-4 space-y-3 text-fluid-sm text-ink-soft">
              {prep.map((p) => <li class="flex gap-3"><span class="mt-[0.65em] h-px w-3 shrink-0 bg-champagne"></span>{p}</li>)}
            </ul>
            <p class="eyebrow mt-8">Aftercare guides</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {aftercare.map((a) => <li><a href={`/support/aftercare/${a.slug}`} class="inline-block rounded-pill border border-stone/60 px-3 py-1.5 text-fluid-xs text-ink-soft hover:border-espresso hover:text-ink">{a.name.replace(" aftercare", "")}</a></li>)}
            </ul>
            <p class="mt-6 text-fluid-xs text-ink-muted">{site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}. <a href={site.address.mapsUrl} target="_blank" rel="noopener" class="underline underline-offset-4">Open in Maps</a>.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const params = new URLSearchParams(location.search);
  const ref = params.get("ref") || "";
  const refEl = document.querySelector<HTMLElement>("[data-ref]");
  let result: { ref?: string; ics?: string; delivered?: boolean; summary?: { treatments: string[]; provider: string; when: string } } | null = null;
  try { result = JSON.parse(sessionStorage.getItem("velmora-booking-result") || "null"); } catch {}
  if (refEl) refEl.textContent = ref || result?.ref || "Reference pending";
  if (result && (!ref || result.ref === ref)) {
    document.querySelector<HTMLElement>("[data-treatments]")!.textContent = result.summary?.treatments.join(", ") ?? "";
    document.querySelector<HTMLElement>("[data-provider]")!.textContent = result.summary?.provider ?? "";
    document.querySelector<HTMLElement>("[data-when]")!.textContent = result.summary?.when ?? "";
    const link = document.getElementById("ics-link") as HTMLAnchorElement | null;
    if (link && result.ics) link.href = URL.createObjectURL(new Blob([result.ics], { type: "text/calendar;charset=utf-8" }));
    if (result.delivered === false) document.querySelector("[data-nomail]")?.classList.remove("hidden");
  } else {
    document.querySelector<HTMLElement>("[data-treatments]")!.textContent = "See your confirmation email";
    document.querySelector<HTMLElement>("[data-provider]")!.textContent = "See your confirmation email";
    document.querySelector<HTMLElement>("[data-when]")!.textContent = "See your confirmation email";
    document.getElementById("ics-link")?.classList.add("hidden");
  }
</script>
